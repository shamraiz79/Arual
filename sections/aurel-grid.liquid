{% liquid
  assign mode = section.settings.mode
  assign default_link = routes.all_products_collection_url
  if mode == 'categories'
    assign anchor = 'aurel-categories'
  elsif mode == 'journal'
    assign anchor = 'aurel-journal'
    assign journal = section.settings.blog
    if journal == blank
      assign journal = blogs.journal | default: blogs.news
    endif
    assign default_link = journal.url
    if default_link == blank
      assign default_link = routes.search_url | append: '?type=article&q=*'
    endif
  else
    assign anchor = 'aurel-products'
  endif
%}
<section id="{{ anchor }}" class="au au-grid-section au-grid-section--{{ mode }}" aria-labelledby="grid-heading-{{ section.id }}">
  <div class="au-grid-intro">
    {% if section.settings.eyebrow != blank %}<p class="au-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 id="grid-heading-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
    {% if section.settings.text != blank %}<p class="au-grid-description">{{ section.settings.text | escape }}</p>{% endif %}
    <a class="au-text-link" href="{{ section.settings.link | default: default_link }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>
  </div>
  <div class="au-card-grid">
    {% for block in section.blocks %}
      {% liquid
        assign product = block.settings.product
        assign collection = block.settings.collection
        assign article = block.settings.article
        if mode == 'journal' and article == blank and journal != blank
          assign article = journal.articles[forloop.index0]
        endif
        assign title = block.settings.title
        assign card_image = block.settings.image
        assign card_link = block.settings.link | default: default_link
        if mode == 'products' and product != blank
          assign title = product.title
          assign card_image = card_image | default: product.featured_image
          assign card_link = product.url
        elsif mode == 'categories' and collection != blank
          assign title = collection.title
          assign card_image = card_image | default: collection.image | default: collection.products.first.featured_image
          assign card_link = collection.url
        elsif mode == 'journal' and article != blank
          assign title = article.title
          assign card_image = card_image | default: article.image
          assign card_link = article.url
        elsif mode == 'journal' and block.settings.link == blank
          assign search_title = title | url_encode
          assign card_link = routes.search_url | append: '?type=article&q=' | append: search_title
        endif
      %}
      <article class="au-card" {{ block.shopify_attributes }}>
        <a class="au-card-photo" href="{{ card_link }}" aria-label="{{ title | escape }}">
          {% render 'aurel-image', image: card_image, fallback: block.settings.fallback, alt: title, sizes: '(min-width: 1000px) 18vw, (min-width: 600px) 30vw, 45vw' %}
        </a>
        <div class="au-card-info">
          <div><h3><a href="{{ card_link }}">{{ title | escape }}{% if mode == 'categories' %} <span aria-hidden="true">→</span>{% endif %}</a></h3>
          {% if mode == 'products' %}
            {% if product != blank %}<p class="au-price">{{ product.price | money }}{% unless product.available %} · Sold out{% endunless %}</p>{% elsif block.settings.caption != blank %}<p class="au-price">{{ block.settings.caption | escape }}</p>{% endif %}
          {% elsif mode == 'journal' %}
            <p class="au-card-date">{% if article != blank %}{{ article.published_at | date: '%b %d, %Y' }}{% else %}{{ block.settings.caption | escape }}{% endif %}</p>
          {% endif %}</div>
          {% if mode == 'products' %}
            {% if product != blank and product.has_only_default_variant and product.available %}
              {% form 'product', product, class: 'au-product-form' %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="au-add" aria-label="Add {{ title | escape }} to bag">{% render 'aurel-icon', icon: 'plus' %}</button>
              {% endform %}
            {% else %}<a class="au-add" href="{{ card_link }}" aria-label="View {{ title | escape }}">{% render 'aurel-icon', icon: 'plus' %}</a>{% endif %}
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Aurél editorial grid","max_blocks":4,"settings":[{"type":"select","id":"mode","label":"Grid type","options":[{"value":"categories","label":"Categories"},{"value":"products","label":"Products"},{"value":"journal","label":"Journal"}],"default":"categories"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"textarea","id":"heading","label":"Heading","default":"Shop\nby Category"},{"type":"textarea","id":"text","label":"Description"},{"type":"text","id":"button","label":"Link label","default":"Explore All"},{"type":"url","id":"link","label":"Link"},{"type":"blog","id":"blog","label":"Blog (journal grid)"}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"product","id":"product","label":"Product (product grid)"},{"type":"collection","id":"collection","label":"Collection (category grid)"},{"type":"article","id":"article","label":"Article (journal grid)"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"title","label":"Fallback title","default":"Home Essentials"},{"type":"text","id":"caption","label":"Fallback price or date"},{"type":"url","id":"link","label":"Fallback link"},{"type":"text","id":"fallback","label":"Theme image filename","default":"aurel-hero.jpg"}]}],"presets":[{"name":"Aurél editorial grid"}]}
{% endschema %}
