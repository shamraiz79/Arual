<section class="au au-hero" aria-labelledby="hero-title-{{ section.id }}">
  <div class="au-hero-photo">
    {% render 'aurel-image', image: section.settings.image, fallback: 'aurel-hero.jpg', alt: 'Olive branches, handmade ceramics and candlelight in a sunlit home', eager: true, sizes: '100vw' %}
  </div>
  <h1 class="au-visually-hidden" id="hero-title-{{ section.id }}">{{ section.settings.heading | default: shop.name | escape }}</h1>
  <div class="au-hero-actions">
    {% if section.settings.button != blank %}
      <a class="au-button au-hero-primary" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">&rarr;</span></a>
    {% endif %}
    {% if section.settings.secondary_button != blank %}
      <a class="au-button au-hero-secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_button | escape }} <span aria-hidden="true">&rarr;</span></a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Aurél hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Accessible heading (visually hidden)",
      "default": "Objects\nfor a More\nIntentional Life."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_button",
      "label": "Secondary button",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Aurél hero"
    }
  ]
}
{% endschema %}
