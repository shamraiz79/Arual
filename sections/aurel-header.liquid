<div class="au au-announcement">
  <span>{{ section.settings.announcement | escape }}</span>
  <span class="au-announcement-note">A more mindful home / A brighter tomorrow</span>
</div>
<header class="au au-header">
  <a class="au-logo" href="{{ routes.root_url }}" aria-label="Aurél home">{{ section.settings.brand | escape }}</a>
  <nav class="au-desktop-nav" aria-label="Main navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">Shop</a><a href="#aurel-categories">Collections</a><a href="#aurel-journal">Journal</a><a href="#aurel-story">About</a>
    {% endif %}
  </nav>
  <div class="au-header-actions">
    <a href="{{ routes.search_url }}" aria-label="Search the store">{% render 'aurel-icon', icon: 'search' %}</a>
    {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="My account">{% render 'aurel-icon', icon: 'account' %}</a>{% endif %}
    <a class="au-cart-link" href="{{ routes.cart_url }}" aria-label="Shopping bag, {{ cart.item_count }} items">{% render 'aurel-icon', icon: 'bag' %}<span data-au-cart-count>{{ cart.item_count }}</span></a>
    <button class="au-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="aurel-mobile-menu">{% render 'aurel-icon', icon: 'menu' %}</button>
  </div>
  <nav id="aurel-mobile-menu" class="au-mobile-nav" aria-label="Mobile navigation" hidden>
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">Shop</a><a href="#aurel-categories">Collections</a><a href="#aurel-journal">Journal</a><a href="#aurel-story">About</a>
    {% endif %}
  </nav>
</header>
{% schema %}
{"name":"Aurél header","settings":[{"type":"text","id":"brand","label":"Brand","default":"AURÉL"},{"type":"text","id":"announcement","label":"Announcement","default":"COMPLIMENTARY SHIPPING ON ORDERS OVER $75  |  30-DAY RETURNS"},{"type":"link_list","id":"menu","label":"Navigation menu"}]}
{% endschema %}
