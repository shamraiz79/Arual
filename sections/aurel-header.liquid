<div class="au au-announcement">
  <span>{{ section.settings.announcement | escape }}</span>
  <span class="au-announcement-note">A more mindful home / A brighter tomorrow</span>
</div>
<header class="au au-header">
  <a class="au-logo" href="{{ routes.root_url }}" aria-label="Aurél home">{{ section.settings.brand | escape }}</a>
  <nav id="aurel-navigation-{{ section.id }}" class="au-main-nav" aria-label="Main navigation">
    {% if section.settings.enable_mega %}
      <details class="au-shop-menu">
        <summary>{{ section.settings.shop_label | escape }} <span class="au-menu-chevron" aria-hidden="true"></span></summary>
        {% render 'aurel-mega-menu', section: section %}
      </details>
    {% else %}
      <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label | escape }}</a>
    {% endif %}
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <details class="au-nav-dropdown"><summary>{{ link.title | escape }} <span class="au-menu-chevron" aria-hidden="true"></span></summary>
            <div class="au-nav-submenu">
              {% for child in link.links %}
                <a href="{{ child.url }}">{{ child.title | escape }}</a>
                {% for grandchild in child.links %}<a class="au-nav-grandchild" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}
              {% endfor %}
            </div>
          </details>
        {% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}
      {% endfor %}
    {% else %}
      <a href="{{ section.settings.collections_link | default: '/#aurel-categories' }}">{{ section.settings.collections_label | escape }}</a>
      <a href="{{ section.settings.journal_link | default: '/#aurel-journal' }}">{{ section.settings.journal_label | escape }}</a>
      <a href="{{ section.settings.story_link | default: '/#aurel-story' }}">{{ section.settings.story_label | escape }}</a>
    {% endif %}
  </nav>
  <div class="au-header-actions">
    <a href="{{ routes.search_url }}" aria-label="Search the store">{% render 'aurel-icon', icon: 'search' %}</a>
    {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="My account">{% render 'aurel-icon', icon: 'account' %}</a>{% endif %}
    <a class="au-cart-link" href="{{ routes.cart_url }}" aria-label="Shopping bag, {{ cart.item_count }} items">{% render 'aurel-icon', icon: 'bag' %}<span data-au-cart-count>{{ cart.item_count }}</span></a>
    <button class="au-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="aurel-navigation-{{ section.id }}">{% render 'aurel-icon', icon: 'menu' %}</button>
  </div>
  <button class="au-menu-backdrop" type="button" aria-label="Close navigation" hidden></button>
</header>
