<section id="aurel-story" class="au au-story" aria-labelledby="story-title-{{ section.id }}">
  {% render 'aurel-image', image: section.settings.image, fallback: 'aurel-story.jpg', alt: 'A quiet moment with a warm cup in a naturally styled home', sizes: '100vw' %}
  <div class="au-story-content">
    <p class="au-eyebrow">A more<br>beautiful<br>tomorrow</p>
    <h2 id="story-title-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
    <span class="au-rule"></span>
    <p>{{ section.settings.text | escape }}</p>
    <a class="au-button au-button--light" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>
  </div>
  <p class="au-story-aside" aria-hidden="true">Kinder<br>homes<br>brighter<br>days</p>
</section>
{% schema %}
{"name":"Aurél brand story","settings":[{"type":"image_picker","id":"image","label":"Background photograph"},{"type":"textarea","id":"heading","label":"Heading","default":"Inspired\nby Nature.\nMade for\nModern Life."},{"type":"textarea","id":"text","label":"Description","default":"We create thoughtfully designed essentials that bring beauty, function and intention into everyday life."},{"type":"text","id":"button","label":"Button","default":"Our Story"},{"type":"url","id":"link","label":"Button link"}],"presets":[{"name":"Aurél brand story"}]}
{% endschema %}
