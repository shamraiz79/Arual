<section class="au au-community" data-au-testimonials aria-labelledby="community-title-{{ section.id }}">
  <div class="au-community-copy">
    <p class="au-eyebrow">Kind words</p><h2 id="community-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2><span class="au-rule"></span>
    <div class="au-quotes" aria-live="polite" aria-atomic="true">
      {% for block in section.blocks %}<figure data-au-quote {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote | escape }}”</blockquote><figcaption>— {{ block.settings.author | escape }}</figcaption></figure>{% endfor %}
    </div>
    {% if section.blocks.size > 1 %}<button class="au-quote-prev" aria-label="Previous testimonial">{% render 'aurel-icon', icon: 'arrow' %}</button><button class="au-quote-next" aria-label="Next testimonial">{% render 'aurel-icon', icon: 'arrow' %}</button>{% endif %}
  </div>
  <div class="au-community-image">{% render 'aurel-image', image: section.settings.image, fallback: 'aurel-community.jpg', alt: 'Considered details: natural ceramics, books and olive branches', sizes: '(min-width: 750px) 35vw, 100vw' %}<p class="au-slide-count"><span data-au-slide>01</span> / {{ section.blocks.size | prepend: '0' }}</p></div>
</section>
{% schema %}
{"name":"Aurél community","settings":[{"type":"text","id":"heading","label":"Heading","default":"From Our Community"},{"type":"image_picker","id":"image","label":"Editorial image"}],"max_blocks":6,"blocks":[{"type":"quote","name":"Testimonial","settings":[{"type":"textarea","id":"quote","label":"Quote"},{"type":"text","id":"author","label":"Customer name"}]}],"presets":[{"name":"Aurél community"}]}
{% endschema %}
